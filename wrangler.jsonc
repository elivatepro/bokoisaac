{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "bokoisaac",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"routes": [
		{ "pattern": "bokoisaac.com", "custom_domain": true },
		{ "pattern": "www.bokoisaac.com", "custom_domain": true }
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Unknown paths get dist/client/404.html with a 404 status. Pages are prerendered; only /api/* runs on
		// the worker (newsletter + comments). Add any future on-demand route to "run_worker_first": with
		// not_found_handling set, browser navigations and form posts otherwise skip the worker.
		"not_found_handling": "404-page",
		"run_worker_first": ["/api/*"]
	},
	// Bot protection for the form endpoints (lib/api.ts human()): 5 posts a minute per IP across /api/*.
	// Pages are static and open to every crawler; only the forms are limited.
	"ratelimits": [{ "name": "FORM_LIMIT", "namespace_id": "7319", "simple": { "limit": 5, "period": 60 } }],
	"observability": {
		"enabled": true
	}
}