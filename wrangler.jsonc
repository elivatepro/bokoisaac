{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "bokoisaac",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"routes": [
		{ "pattern": "bokoisaac.com", "custom_domain": true },
		{ "pattern": "www.bokoisaac.com", "custom_domain": true }
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Unknown paths get dist/client/404.html with a 404 status. Every page is prerendered, so there is no
		// worker to render it. If on-demand (SSR) pages are added later, list them in "run_worker_first":
		// with not_found_handling set, browser navigations otherwise skip the worker.
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	}
}