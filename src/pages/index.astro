---
// Temporary page that proves the Notion pipeline works. Replaced when the Home design is built.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const services = (await getCollection('services', ({ data }) => data.published)).sort((a, b) => a.data.order - b.data.order);
const unit = { project: '', month: ' a month', hour: ' an hour' } as const;
---

<Base>
  <main class="page py-32">
    <p class="eyebrow"><span class="text-coral">//</span> Services</p>
    <h1 class="mt-3 text-5xl font-semibold tracking-tight">What I build</h1>
    <ul class="mt-12 divide-y divide-rule border-y border-rule">
      {
        services.map(({ data }) => (
          <li class="flex items-baseline justify-between py-5">
            <span class="text-xl">{data.name}</span>
            <span class="font-mono text-sm text-muted">
              {data.priceUnit === 'hour' ? '' : 'From '}${data.priceFrom?.toLocaleString('en-US')}
              {unit[data.priceUnit]}
            </span>
          </li>
        ))
      }
    </ul>
  </main>
</Base>
