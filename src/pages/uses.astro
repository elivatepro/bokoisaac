---
// Uses, from Paper ("Boko Isaac - Uses" → "Uses" / "Uses — Mobile"). Groups of everyday kit, an editor config
// block (with the same Copy button as post code blocks) and a dated footnote.
import Base from '../layouts/Base.astro';
import PageHero from '../components/site/PageHero.astro';
import Button from '../components/ui/Button.astro';
import Contact from '../components/home/Contact.astro';
import { EDITOR_CONFIG, USES, USES_CHECKED } from '../lib/stack';

const pad = (n: number) => String(n).padStart(2, '0');
const mono = 'font-mono font-medium tracking-[0.01em] tabular-nums';
const group = 'grid min-w-0 grid-cols-[minmax(0,1fr)] items-start gap-x-24 gap-y-5 border-b border-rule pt-9 pb-10 md:grid-cols-[minmax(0,300px)_minmax(0,1fr)] md:gap-y-6 md:pt-[52px] md:pb-[60px]';
const groupTitle = 'text-[26px] leading-[105%] font-semibold tracking-[-0.042em] md:text-[36px] md:tracking-[-0.045em]';
const arrow = 'M5 12h14M13 6l6 6-6 6';
const copyIcon = 'M5 12.5l4.5 4.5L19 7.5';
// Editor config sits between the second and third numbered groups.
const before = USES.slice(0, 2);
const after = USES.slice(2);
const configLines = EDITOR_CONFIG.split('\n');
---

<Base title="Uses" description="The desk, the editor and the rest: the hardware, apps and settings Boko Isaac uses every day. Nothing is sponsored.">
  <PageHero
    id="uses-title"
    eyebrow="Uses"
    title="The desk, the editor and"
    accent="the rest."
    lead="People ask, so here is the list. Nothing on it is sponsored. Most of it is ordinary, and that is the point."
    padClass="pt-[112px] pb-16 md:pt-[208px] md:pb-[60px]"
    gapClass="gap-[22px]"
  >
    <Button slot="actions" href="/stack" variant="secondary" icon="none">See the stack</Button>
  </PageHero>

  <section aria-label="What I use">
    <div class="page pb-16 md:py-[112px]">
      <div class="grid grid-cols-[minmax(0,1fr)] border-t border-rule">
        {
          [before, after].map((list, half) => (
            <>
              {list.map((g, j) => {
                const n = half * before.length + j + 1;
                return (
                  <section data-reveal class={group} aria-labelledby={`uses-${n}`}>
                    <div class="flex min-w-0 flex-wrap items-baseline gap-x-[14px] gap-y-[6px]">
                      <span class:list={[mono, 'text-[12.5px] leading-[150%] text-muted']}>{pad(n)}</span>
                      <h2 id={`uses-${n}`} class={groupTitle}>
                        {g.name}
                      </h2>
                      <span class:list={[mono, 'basis-full text-[12.5px] leading-[150%] text-muted']}>{g.items.length} items</span>
                    </div>
                    <ul class="grid min-w-0 grid-cols-[minmax(0,1fr)]">
                      {g.items.map((it, k) => (
                        <li class:list={['min-w-0', k < g.items.length - 1 && 'border-b border-rule']}>
                          <div
                            class:list={[
                              'grid min-h-[60px] items-baseline gap-x-7 gap-y-[6px] md:grid-cols-[minmax(0,4fr)_minmax(0,6fr)_36px]',
                              it.href ? 'grid-cols-[minmax(0,1fr)_36px]' : 'grid-cols-[minmax(0,1fr)]',
                              k === 0 ? 'pt-1' : 'pt-4',
                              k < g.items.length - 1 && 'pb-4',
                            ]}
                          >
                            <h3 class="min-w-0 text-[19px] leading-[120%] font-semibold tracking-[-0.945px] md:text-[21px]">{it.name}</h3>
                            <p class:list={['min-w-0 text-[15.5px] leading-[155%] text-pretty text-muted', it.href && 'max-md:col-span-2']}>{it.note}</p>
                            {it.href && (
                              <a
                                href={it.href}
                                target="_blank"
                                rel="noopener"
                                aria-label={`${it.name} website (opens in a new tab)`}
                                class="uses-tile col-start-2 row-start-1 grid size-9 place-items-center self-center justify-self-end rounded-[9px] md:col-start-3"
                              >
                                <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                                  <path d={arrow} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                              </a>
                            )}
                          </div>
                        </li>
                      ))}
                    </ul>
                  </section>
                );
              })}
              {half === 0 && (
                <section data-reveal class={group} aria-labelledby="uses-config">
                  <h2 id="uses-config" class={groupTitle}>
                    Editor config
                  </h2>
                  <figure class="uses-code grid min-w-0 max-w-[760px] grid-cols-[minmax(0,1fr)] overflow-clip rounded-[12px] bg-field shadow-[inset_0_0_0_1px_var(--color-rule)]">
                    <figcaption class="flex min-h-10 items-center justify-between gap-3 border-b border-[#f1f2ec1a] pr-[6px] pl-4 font-mono text-[12px] leading-[140%] font-medium tracking-[0.01em] text-muted">
                      <span>settings.json</span>
                      <button type="button" data-copy aria-label="Copy settings.json" class="flex min-h-8 items-center gap-1.5 rounded-[7px] px-[10px] font-sans text-[12px] leading-none font-medium text-muted transition-colors hover:bg-ink/6 hover:text-ink">
                        <span data-copy-label>Copy</span>
                        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" class="copy-ok hidden text-coral">
                          <path d={copyIcon} fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </button>
                    </figcaption>
                    <pre data-lenis-prevent class="overflow-x-auto px-[14px] pt-4 pb-[18px] md:px-[18px]"><code class="font-mono text-[11.5px] leading-[165%] [tab-size:2] md:text-[13px]">{configLines.map((line, i) => <><span class={line.trim().startsWith('//') ? 'text-muted' : 'text-ink'}>{line}</span>{i < configLines.length - 1 && '\n'}</>)}</code></pre>
                  </figure>
                </section>
              )}
            </>
          ))
        }
      </div>
      <p class:list={[mono, 'mt-[26px] max-w-[624px] text-[12px] leading-[140%] text-muted']}>Last checked {USES_CHECKED}. Nothing here is sponsored.</p>
    </div>
  </section>

  <Contact />
</Base>

<style>
  .uses-tile {
    color: var(--color-coral);
    box-shadow: inset 0 0 0 1px var(--color-rule-strong);
    transition:
      background-color 0.3s,
      color 0.3s,
      box-shadow 0.3s;
  }
  .uses-tile:hover,
  .uses-tile:focus-visible {
    background: var(--color-coral);
    color: var(--color-coral-ink);
    box-shadow: none;
  }
  .uses-tile svg {
    transition: translate 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .uses-tile:hover svg {
    translate: 2px 0;
  }
  .uses-code [data-copy][data-copied] {
    color: var(--color-ink);
  }
  .uses-code [data-copy][data-copied] .copy-ok {
    display: block;
  }
</style>

<script>
  import '../scripts/writing/forms';
</script>
