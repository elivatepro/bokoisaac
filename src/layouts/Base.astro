---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import { SITE, person, website } from '../lib/seo';

/** Share card data: rendered after the build to /og/<path>.png (scripts/og.mjs, design "Share card — Post"). */
interface OgCard {
  /** Big title on the card; defaults to the page title. */
  title?: string;
  /** "// Section" label; defaults to the first path segment ("Work", "Writing"…). */
  section?: string;
  /** Extra footer text, e.g. "6 min". */
  meta?: string;
  /** Date shown bottom right (YYYY-MM-DD). */
  date?: string;
}

interface Props {
  title?: string;
  description?: string;
  /** Card data, or false to use the default card (home, 404). */
  og?: OgCard | false;
  type?: 'website' | 'article' | 'profile';
  /** Extra schema.org nodes for this page (Article, BreadcrumbList…); Person + WebSite are always included. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** ISO dates for article metadata. */
  published?: Date | null;
  modified?: Date | null;
}

const { title, description = SITE.description, og = {}, type = 'website', jsonLd = [], noindex = false, published, modified } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.jobTitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Share card: the home page and pages that opt out use the exported default card.
const path = Astro.url.pathname.replace(/^\/|\/$/g, '');
const titleCase = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const card =
  og === false || !path
    ? null
    : {
        path,
        section: og.section ?? titleCase(path.split('/')[0]!),
        title: og.title ?? title ?? SITE.name,
        meta: og.meta,
        date: og.date,
      };
const image = new URL(card ? `/og/${path}.png` : '/og/default.png', Astro.site).href;
const imageAlt = card ? `${card.title} — ${SITE.name}` : `${SITE.name}, ${SITE.tagline}`;
const ld = { '@context': 'https://schema.org', '@graph': [person, website, ...jsonLd] };

---

<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-48.png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content="#0B0C0E" />
    <meta name="color-scheme" content="dark" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Writing`} href="/writing/rss.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={SITE.url} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {card && <meta name="bi-og" content={JSON.stringify(card)} />}
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <ClientRouter />
    {/* Boot loader, before first paint: cover the page on the first visit of a session (#1).
        Skipped for reduced motion; a 5s failsafe uncovers the page if the loader script never runs. */}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches || sessionStorage.getItem('bi-loaded')) return;
        } catch (e) {
          return;
        }
        d.classList.add('shl-go', 'is-holding');
        setTimeout(function () {
          if (!d.classList.contains('shl-go')) return;
          d.classList.remove('shl-go', 'is-holding');
          window.dispatchEvent(new Event('site:ready'));
        }, 5000);
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-bg text-ink">
    {/* Loader + page-transition panel. Persisted across ClientRouter swaps so the wipe can span a navigation. */}
    <div id="shl" class="shl" aria-hidden="true" transition:persist="site-shl">
      <div class="shl-wipe"></div>
      <div class="shl-scan"></div>
      <div class="shl-body">
        <div class="page flex h-full flex-col justify-center" aria-hidden="true">
          <div class="flex w-full max-w-[460px] flex-col gap-4 font-mono text-[14px] leading-[150%] font-medium tracking-[0.01em]">
            <p class="flex items-center whitespace-pre text-ink">
              <span class="text-coral">&gt; </span><span data-shl-text>boko isaac — full-stack engineer</span><span
                class="shl-caret ml-1 inline-block h-[1.15em] w-[0.6em] bg-coral"></span>
            </p>
            <div class="relative h-[2px]">
              <div class="absolute inset-x-0 top-[0.5px] h-px bg-ink/16"></div>
              <div class="shl-fill absolute inset-0 bg-coral"></div>
            </div>
            <p class="min-h-[1.5em] text-[12.5px] text-muted" data-shl-sub></p>
          </div>
        </div>
        <button
          type="button"
          data-shl-skip
          class="absolute right-5 bottom-5 flex h-11 items-center rounded-[12px] border border-rule-strong px-4 font-mono text-[12.5px] font-medium text-ink hover:border-ink/40 md:right-[56px] md:bottom-8"
        >
          Skip intro
        </button>
      </div>
    </div>

    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    {/* Custom cursor (#4); see scripts/site/cursor.ts for the data-cursor="Label" convention. */}
    <div id="cursor" class="cur" aria-hidden="true" transition:persist="site-cursor">
      <div class="cur-dot"></div>
      <div class="cur-label"></div>
    </div>

    <script>
      import '../scripts/site/loader';
      import '../scripts/site/transition';
      import '../scripts/site/smooth';
      import '../scripts/site/cursor';
      import '../scripts/site/header';
      import '../scripts/site/menu';
      import '../scripts/motion/reveal';
    </script>
  </body>
</html>
