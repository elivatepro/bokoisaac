---
// "Notes from the build." Latest post as a card, the next four as a list.
// Rows come from Notion Blog (newest first); the section is hidden when there are none.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { live } from '../../lib/content';

const posts = (await live('blog')).sort((a, b) => (b.data.published?.getTime() ?? 0) - (a.data.published?.getTime() ?? 0));
const [latest, ...rest] = posts;
const earlier = rest.slice(0, 4);

// Notion file URLs expire after an hour, so covers are bundled in src/assets/home/writing/<slug>.webp for now.
// TODO: replace with a Notion image download step at build time.
const covers = import.meta.glob<{ default: ImageMetadata }>('../../assets/home/writing/*.{webp,jpg,jpeg,png}', { eager: true });
const coverFor = (slug: string) => Object.entries(covers).find(([path]) => path.split('/').pop()!.replace(/\.\w+$/, '') === slug)?.[1].default;

const href = (slug: string) => `/writing/${slug}`;
const day = (d: Date | null) => d?.toISOString().slice(0, 10) ?? '';
const read = (m: number | null) => (m ? `${m} min read` : '');
const mono = 'font-mono font-medium tracking-[0.01em] tabular-nums';
const arrow = 'M5 12h14M13 6l6 6-6 6';
const latestCover = latest && coverFor(latest.data.slug);
---

{
  latest && (
    <section data-section="Writing" id="writing" aria-labelledby="writing-title" class="bg-bg">
      <div class="page py-[68px] md:py-[151.2px]">
        <div class="flex items-end justify-between gap-10">
          <div class="grid max-w-[920px] min-w-0 justify-items-start gap-4 md:gap-[22px]">
            <p data-reveal="eyebrow" class="eyebrow text-ink max-md:text-[12px]"><span class="text-coral">//</span> Writing</p>
            <h2 id="writing-title" data-reveal="words" class="text-[38.4px] leading-none font-semibold tracking-[-0.045em] text-balance md:text-[64px]">
              Notes from the <span class="text-coral">build.</span>
            </h2>
            <p data-reveal data-reveal-delay="200" class="max-w-[527px] text-[15.5px] leading-[160%] text-pretty text-muted md:max-w-[578px] md:text-[17px]">
              Short, specific posts about TypeScript, APIs and the unglamorous parts of shipping software.
            </p>
          </div>
          <a href="/writing" data-reveal data-reveal-delay="260" class:list={[mono, 'link-draw hidden min-h-11 shrink-0 items-center gap-[9px] pb-0.5 text-[13px] leading-none md:inline-flex']}>
            <span class="link-draw-n text-muted">01</span>
            <span class="link-draw-l py-1.5">All writing</span>
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" class="shrink-0">
              <path d={arrow} fill="none" stroke="var(--color-coral)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>

        <div class="mt-10 grid grid-cols-[minmax(0,1fr)] gap-9 md:mt-16 md:grid-cols-[minmax(0,1.06fr)_minmax(0,1fr)] md:gap-14">
          <article data-reveal data-reveal-delay="340" data-cursor="Read" class="wr-card group relative flex min-w-0 flex-col rounded-[14px] bg-surface p-2 shadow-[inset_0_0_0_1px_var(--color-rule)]">
            <div class="relative aspect-video overflow-clip rounded-[9px] bg-field md:aspect-[16/10]">
              {latestCover && (
                <Image
                  src={latestCover}
                  alt=""
                  widths={[400, 700, 1000, 1400]}
                  sizes="(min-width: 768px) 50vw, 100vw"
                  class="absolute inset-0 size-full object-cover saturate-[0.92] contrast-[1.04] transition-transform duration-500 group-hover:scale-[1.02]"
                />
              )}
              <span class:list={[mono, 'absolute top-[10px] left-[10px] flex h-[26px] items-center rounded-[7px] bg-coral px-[9px] text-[12px] leading-none text-coral-ink']}>
                Latest
              </span>
              <span class="pointer-events-none absolute inset-0 rounded-[9px] shadow-[inset_0_0_0_1px_var(--color-rule)]" aria-hidden="true" />
            </div>
            <div class="flex grow flex-col gap-3 px-3 pt-[18px] pb-[14px] md:gap-[14px] md:px-[18px] md:pt-[22px] md:pb-[18px]">
              <p class="flex flex-wrap items-center gap-x-[14px] gap-y-2">
                {latest.data.tags[0] && (
                  <span class:list={[mono, 'flex h-[26px] items-center rounded-[7px] px-[9px] text-[12px] leading-none text-coral shadow-[inset_0_0_0_1px_#ff7f5073]']}>
                    {latest.data.tags[0]}
                  </span>
                )}
                {latest.data.published && (
                  <time datetime={day(latest.data.published)} class:list={[mono, 'text-[12px] leading-[140%] text-muted']}>
                    {day(latest.data.published)}
                  </time>
                )}
                {latest.data.readingTime && <span class:list={[mono, 'text-[12px] leading-[140%] text-muted']}>{read(latest.data.readingTime)}</span>}
              </p>
              <h3 class="text-[26px] leading-[104%] font-semibold tracking-[-0.045em] text-balance md:text-[38px]">
                <a href={href(latest.data.slug)} class="after:absolute after:inset-0 after:rounded-[14px] focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-3 focus-visible:after:outline-coral">
                  {latest.data.title}
                </a>
              </h3>
              {latest.data.excerpt && (
                <p class="max-w-[510px] text-[15px] leading-[155%] text-pretty text-muted md:max-w-[544px] md:text-[16px]">{latest.data.excerpt}</p>
              )}
              <p class="mt-auto flex items-center gap-2 pt-[10px]" aria-hidden="true">
                <span class:list={[mono, 'text-[12.5px] leading-[150%] group-hover:underline underline-offset-4']}>Read post</span>
                <svg viewBox="0 0 24 24" width="14" height="14" class="shrink-0 transition-transform duration-300 group-hover:translate-x-[3px] group-focus-within:translate-x-[3px]">
                  <path d={arrow} fill="none" stroke="var(--color-coral)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </p>
            </div>
          </article>

          {
            earlier.length > 0 && (
              <div data-reveal data-reveal-delay="300" class="flex min-w-0 flex-col">
                <h3 class:list={[mono, 'pb-[14px] text-[12px] leading-[140%] text-muted']}>
                  <span class="text-coral">//</span> Earlier posts
                </h3>
                <ul data-reveal-stagger="60" data-reveal-delay="380" class="grid grow border-b border-rule md:auto-rows-[minmax(84px,1fr)]">
                  {earlier.map((p) => (
                    <li class="grid min-w-0 border-t border-rule">
                      <a
                        href={href(p.data.slug)}
                        data-cursor="Read"
                        class="wr-row group grid min-w-0 grid-cols-[minmax(0,1fr)_auto_18px] items-center gap-x-3 gap-y-1.5 px-0.5 py-4 [grid-template-areas:'date_read_arr''name_name_arr'] md:grid-cols-[104px_minmax(0,1fr)_auto_20px] md:gap-5 md:px-1 md:[grid-template-areas:'date_name_read_arr']"
                      >
                        <time datetime={day(p.data.published)} class:list={[mono, 'w-max text-[12.5px] leading-[150%] text-muted [grid-area:date]']}>
                          {day(p.data.published)}
                        </time>
                        <span class="text-[20px] leading-[112%] font-semibold tracking-[-0.045em] text-balance [grid-area:name] group-hover:text-coral md:text-[25px]">
                          {p.data.title}
                        </span>
                        <span class:list={[mono, 'w-max text-[12.5px] leading-[150%] text-muted [grid-area:read]']}>{read(p.data.readingTime)}</span>
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="justify-self-center text-muted transition-[translate,color] [grid-area:arr] group-hover:translate-x-0.5 group-hover:text-coral">
                          <path d={arrow} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>

        <a href="/writing" class:list={[mono, 'link-draw mt-7 inline-flex min-h-11 items-center gap-[9px] text-[13px] leading-none md:hidden']}>
          <span class="link-draw-n text-muted">01</span>
          <span class="link-draw-l py-1.5">All writing</span>
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" class="shrink-0">
            <path d={arrow} fill="none" stroke="var(--color-coral)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </section>
  )
}

<style>
  /* #27 feature card lift. */
  .wr-card {
    transition:
      translate 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.3s ease;
  }
  .wr-card:hover,
  .wr-card:focus-within {
    translate: 0 -4px;
    box-shadow: inset 0 0 0 1px var(--color-coral);
  }

  /* #29 row slide: padding-left 4px -> 14px plus a soft surface wash. */
  .wr-row {
    transition:
      padding-left 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 0.3s ease;
  }
  .wr-row:hover,
  .wr-row:focus-visible {
    padding-left: 14px;
    background-color: color-mix(in srgb, var(--color-surface) 70%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .wr-card:hover,
    .wr-card:focus-within {
      translate: none;
    }
    .wr-row {
      transition: none;
    }
  }
</style>
