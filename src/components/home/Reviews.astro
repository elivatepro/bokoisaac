---
// "Reviewed, then approved." Client quotes styled as a code review of reviews/clients.md.
// Rows come from Notion Reviews; the section is hidden when there are none.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { live } from '../../lib/content';

const reviews = await live('reviews');

// Notion file URLs expire after an hour, so the Notion Photo field is not used yet: photos are bundled
// in src/assets/home/reviews/ and matched by reviewer name (e.g. ingrid-solvang.webp).
// TODO: replace with a Notion image download step at build time.
const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/home/reviews/*.{webp,jpg,jpeg,png}', { eager: true });
const slug = (s: string) => s.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const photoFor = (name: string) => Object.entries(photos).find(([path]) => path.split('/').pop()!.replace(/\.\w+$/, '') === slug(name))?.[1].default;

const mono = 'font-mono font-medium tracking-[0.01em] tabular-nums';
const check = 'M5 12.5l4.5 4.5L19 7.5';
---

{
  reviews.length > 0 && (
    <section data-section="Reviews" id="reviews" aria-labelledby="reviews-title" class="bg-bg">
      <div class="page py-[68px] md:py-[151.2px]">
        <div class="grid max-w-[920px] justify-items-start gap-4 md:gap-[22px]">
          <Eyebrow class="max-md:text-[12px]">Code review</Eyebrow>
          <h2 id="reviews-title" class="text-[38.4px] leading-none font-semibold tracking-[-0.045em] text-balance md:text-[64px]">
            Reviewed, then <span class="text-coral">approved.</span>
          </h2>
          <p class="max-w-[527px] text-[15.5px] leading-[160%] text-pretty text-muted md:max-w-[578px] md:text-[17px]">
            The people who merged the work, in their own words.
          </p>
        </div>

        <div class="mt-10 overflow-clip rounded-[14px] bg-surface shadow-[inset_0_0_0_1px_var(--color-rule)] md:mt-16">
          <div class="flex min-h-[49px] items-center justify-between gap-4 border-b border-rule bg-field py-2 pr-4 md:min-h-[53px] md:pr-6">
            <p class="-my-2 flex items-center gap-[10px] self-stretch bg-surface px-4 shadow-[inset_0_2px_0_var(--color-coral),1px_0_0_var(--color-rule)] md:px-[22px]">
              <span class="size-[7px] shrink-0 rounded-full bg-coral" aria-hidden="true"></span>
              <span class:list={[mono, 'text-[12.5px] leading-[130%] md:leading-[150%]']}>reviews/clients.md</span>
            </p>
            <p class="flex shrink-0 items-center gap-2">
              <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true" class="shrink-0">
                <path d={check} fill="none" stroke="var(--color-coral)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class:list={[mono, 'text-[12.5px] leading-[150%]']}>{reviews.length} of {reviews.length} approved</span>
            </p>
          </div>

          <div class="relative md:grid md:grid-cols-[68px_minmax(0,1fr)]">
            {/* Line numbers: as many as fit; the column is clipped to the list height. */}
            <div class="absolute inset-y-0 left-0 hidden w-[68px] justify-end overflow-clip border-r border-rule pt-8 pr-4 md:flex" aria-hidden="true">
              <p class="w-max text-right font-mono text-[12px] leading-8 text-muted tabular-nums">
                {Array.from({ length: reviews.length * 6 + 2 }, (_, i) => <>{i + 1}<br /></>)}
              </p>
            </div>

            <ul class="grid grid-cols-[minmax(0,1fr)] gap-7 py-5 md:col-start-2 md:gap-8 md:py-8">
              {
                reviews.map((r, i) => {
                  const photo = photoFor(r.data.name);
                  const meta = [r.data.role, r.data.company].filter(Boolean).join(' · ');
                  return (
                    <li class="relative min-w-0 px-4 md:pr-8 md:pl-7">
                      {i > 0 && <span class="absolute inset-x-0 -top-[14px] h-px bg-rule md:-top-4" aria-hidden="true" />}
                      <span class="absolute inset-y-0 -left-px w-[2px] bg-coral" aria-hidden="true" />
                      <figure class="grid grid-cols-[minmax(0,1fr)] items-start md:grid-cols-[336px_minmax(0,1fr)_auto] md:gap-x-9">
                        <figcaption class="relative grid min-h-14 grid-cols-[minmax(0,1fr)] pl-[52px] md:min-h-16 md:pl-14">
                          <span class="text-[15.5px] leading-7 font-semibold md:text-[16px] md:leading-8">{r.data.name}</span>
                          {meta && <span class:list={[mono, 'text-[12.5px] leading-7 text-muted md:leading-8']}>{meta}</span>}
                          <span class="absolute top-2 left-0 grid size-10 place-items-center rounded-full bg-surface shadow-[inset_0_0_0_1px_var(--color-rule-strong)] md:top-3">
                            {photo && <Image src={photo} alt="" width={80} height={80} class="size-full rounded-full object-cover saturate-90" />}
                          </span>
                        </figcaption>
                        <blockquote class="mt-7 max-w-[680px] min-w-0 text-[17px] leading-7 tracking-[-0.005em] text-pretty md:mt-0 md:max-w-[840px] md:text-[21px] md:leading-8 md:tracking-[-0.012em]">
                          <p>{r.data.quote}</p>
                        </blockquote>
                        <p class="mt-7 flex h-7 items-center md:mt-0 md:h-8">
                          <span class="flex h-6 items-center gap-[7px] rounded-[7px] px-[9px] shadow-[inset_0_0_0_1px_#ff7f5073]">
                            <svg viewBox="0 0 24 24" width="11" height="11" aria-hidden="true" class="shrink-0">
                              <path d={check} fill="none" stroke="var(--color-coral)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            <span class:list={[mono, 'text-[12px] leading-none text-coral']}>Approved</span>
                          </span>
                        </p>
                      </figure>
                    </li>
                  );
                })
              }
            </ul>
          </div>
        </div>
      </div>
    </section>
  )
}
