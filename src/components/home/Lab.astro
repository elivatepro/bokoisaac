---
// "What I build when nobody asks." A horizontal rail of the Lab items, from lib/lab.ts (the same data as /lab;
// the Notion Lab rows are still empty drafts). Stars and downloads show only once they are real numbers.
import { Image } from 'astro:assets';
import { lab } from '../../lib/lab';

const items = lab.map((l) => ({ slug: l.slug, name: l.name, type: l.kind, summary: l.summary, cover: l.image }));
const STATS: Record<string, { stars?: number; downloads?: number }> = Object.fromEntries(lab.map((l) => [l.slug, { stars: l.stars, downloads: l.downloads }]));
const num = (n: number) => n.toLocaleString('en-US');
const mono = 'font-mono font-medium';
const arrow = 'M5 12h14M13 6l6 6-6 6';
---

{
  items.length > 0 && (
    <section id="lab" data-section="Lab" aria-labelledby="lab-title" class="overflow-clip bg-field" data-lab>
      <div class="page flex items-end justify-between gap-10 pt-[68px] md:pt-[151.2px]">
        <div class="grid max-w-[920px] min-w-0 justify-items-start gap-4 md:gap-[22px]">
          <p data-reveal="eyebrow" class:list={[mono, 'text-[12px] leading-[150%] tracking-[0.01em] md:text-[13px]']}>
            <span class="text-coral">//</span> Open source and experiments
          </p>
          <h2 id="lab-title" data-reveal="words" class="text-[38.4px] leading-none font-semibold tracking-[-0.045em] text-balance md:text-[64px]">
            What I build when <span class="text-coral">nobody</span> asks.
          </h2>
          <p data-reveal data-reveal-delay="200" class="max-w-[527px] text-[15.5px] leading-[160%] text-pretty text-muted md:max-w-[578px] md:text-[17px]">
            Small libraries, command line tools and sketches. Most started as a fix for one project and stayed useful.
          </p>
        </div>
        <div data-reveal data-reveal-delay="260" class="hidden shrink-0 gap-2 md:flex">
          <button type="button" data-lab-prev aria-label="Previous projects" aria-controls="lab-rail" class="lab-nav">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path d="M19 12H5M11 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <button type="button" data-lab-next aria-label="Next projects" aria-controls="lab-rail" class="lab-nav">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path d={arrow} fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </div>

      <ul
        id="lab-rail"
        data-lab-rail
        data-reveal-stagger="70"
        data-reveal-delay="300"
        data-reveal-max="5"
        aria-label="Lab projects"
        class="lab-rail mt-7 flex gap-3.5 overflow-x-auto overscroll-x-contain px-5 py-3 md:mt-11 md:gap-5"
      >
        {items.map((item) => {
          const cover = item.cover;
          const stats = STATS[item.slug] ?? {};
          return (
            <li class="w-[min(320px,100%-36px)] shrink-0 snap-start md:w-[min(400px,100%-44px)]">
              <a
                href={`/lab/${item.slug}`}
                data-cursor="Open"
                class="lab-card group flex h-full flex-col rounded-[14px] bg-surface p-2 shadow-[inset_0_0_0_1px_var(--color-rule)]"
              >
                <div class="relative aspect-[16/10] overflow-clip rounded-[9px] bg-field">
                  {cover && (
                    <Image
                      src={cover}
                      alt=""
                      widths={[400, 800]}
                      sizes="(min-width: 768px) 384px, 304px"
                      class="absolute inset-0 size-full object-cover brightness-[62%] contrast-[108%] grayscale-[55%] transition-transform duration-500 group-hover:scale-[1.03]"
                    />
                  )}
                  <div class="absolute inset-0 rounded-[9px] shadow-[inset_0_0_0_1px_var(--color-rule)]" />
                  <div class="lab-veil absolute inset-0 bg-field/26" />
                  {item.type && (
                    <span
                      class:list={[mono, 'absolute top-2.5 left-2.5 inline-flex h-[26px] items-center rounded-[7px] bg-coral px-[9px] text-[12px] leading-none tracking-[0.01em] text-coral-ink']}
                    >
                      {item.type}
                    </span>
                  )}
                </div>
                <div class="flex grow basis-0 flex-col gap-2.5 px-3.5 pt-5 pb-3">
                  <h3 class="text-[23px] leading-[105%] font-semibold tracking-[-0.045em] text-balance md:text-[26px]">{item.name}</h3>
                  <p class="mb-2 text-[15px] leading-[150%] text-pretty text-muted">{item.summary}</p>
                  <div class:list={[mono, 'mt-auto flex flex-wrap items-center gap-x-[18px] gap-y-2 border-t border-rule pt-3.5 text-[12.5px] leading-[150%] tracking-[0.01em] tabular-nums']}>
                    {stats.stars != null && (
                      <span class="flex items-center gap-[7px]">
                        <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" class="shrink-0">
                          <path d="M12 2.6l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 17.6l-5.9 3.2 1.2-6.6-4.8-4.6 6.6-.9z" fill="var(--color-coral)" />
                        </svg>
                        {num(stats.stars)}
                        <span class="text-muted italic md:not-italic">stars</span>
                      </span>
                    )}
                    {stats.downloads != null && (
                      <span class="flex items-center gap-[7px]">
                        <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" class="shrink-0">
                          <path d="M12 4v12M6.5 11l5.5 5.5 5.5-5.5M5 20.5h14" fill="none" stroke="var(--color-coral)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        {num(stats.downloads)}
                        <span class="text-muted italic md:not-italic">downloads</span>
                      </span>
                    )}
                    <span class="ml-auto flex items-center gap-1.5 text-muted transition-colors group-hover:text-ink" aria-hidden="true">
                      Open
                      <svg viewBox="0 0 24 24" width="13" height="13" class="shrink-0 transition-transform duration-300 group-hover:translate-x-[3px] group-focus-visible:translate-x-[3px]">
                        <path d={arrow} fill="none" stroke="var(--color-coral)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </div>
                </div>
              </a>
            </li>
          );
        })}
      </ul>

      <div class="page flex items-center justify-between gap-5 pb-[68px] md:gap-8 md:pb-[151.2px]">
        <div data-lab-track class="lab-track relative h-0.5 max-w-[320px] min-w-0 grow basis-0 overflow-clip rounded-[2px] bg-rule-strong" aria-hidden="true">
          <div data-lab-progress class="lab-thumb absolute inset-y-0 left-0 rounded-[2px] bg-coral" />
        </div>
        <a href="/lab" data-reveal data-reveal-delay="260" class:list={[mono, 'link-draw flex min-h-11 items-center gap-[9px] rounded-sm text-[13px] leading-none tracking-[0.01em]']}>
          <span class="link-draw-n text-muted">02</span>
          <span class="link-draw-l py-1.5">Everything in the lab</span>
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" class="shrink-0 text-coral">
            <path d={arrow} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </section>
  )
}

<style>
  .lab-rail {
    scrollbar-width: none;
    scroll-padding-inline: 20px;
  }
  .lab-rail::-webkit-scrollbar {
    display: none;
  }
  @media (width >= 48rem) {
    .lab-rail {
      padding-inline: max(56px, 50% - 704px);
      scroll-padding-inline: max(56px, 50% - 704px);
    }
  }
  /* Snap only for touch and phones (#26); on desktop it would fight drag and inertia. */
  @media (pointer: coarse), (width < 810px) {
    .lab-rail {
      scroll-snap-type: x mandatory;
    }
  }
  .lab-rail.is-drag,
  .lab-rail.is-glide {
    scroll-snap-type: none;
    scroll-behavior: auto;
  }
  .lab-rail.is-drag {
    cursor: grabbing;
    user-select: none;
  }

  /* Progress: thumb width = visible share, translated by scroll progress. */
  .lab-thumb {
    width: calc(var(--f, 0.2) * 100%);
    transform: translateX(calc(var(--p, 0) * (1 / var(--f, 0.2) - 1) * 100%));
  }
  .lab-track.is-fit {
    visibility: hidden;
  }

  /* #27 card hover lift. */
  .lab-card {
    --ui: cubic-bezier(0.2, 0.8, 0.2, 1);
    transition:
      translate 0.5s var(--ui),
      box-shadow 0.3s ease;
  }
  .lab-card :global(img) {
    transition:
      filter 0.5s ease,
      scale 0.5s ease;
  }
  .lab-veil {
    transition: opacity 0.5s ease;
  }
  .lab-card:hover,
  .lab-card:focus-visible {
    translate: 0 -4px;
    box-shadow: inset 0 0 0 1px var(--color-coral);
  }
  .lab-card:hover :global(img),
  .lab-card:focus-visible :global(img) {
    filter: brightness(84%) contrast(104%) grayscale(10%);
  }
  .lab-card:hover .lab-veil,
  .lab-card:focus-visible .lab-veil {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .lab-card:hover,
    .lab-card:focus-visible {
      translate: none;
    }
  }

  .lab-nav {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    flex-shrink: 0;
    border: 1px solid var(--color-rule-strong);
    border-radius: 14px;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      opacity 200ms ease,
      border-color 200ms ease,
      color 200ms ease,
      scale 120ms ease;
  }
  .lab-nav:hover:not(:disabled) {
    border-color: var(--color-coral);
    color: var(--color-coral);
  }
  .lab-nav:active:not(:disabled) {
    scale: 0.96;
  }
  .lab-nav:disabled {
    opacity: 0.38;
    cursor: default;
  }
  @media (prefers-reduced-motion: no-preference) {
    .lab-rail {
      scroll-behavior: smooth;
    }
  }
</style>

<script>
  import '../../scripts/sections/lab-rail';
</script>
