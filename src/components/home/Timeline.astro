---
// "Six years, every one committed." Career as a git log. Static copy from Paper (Home, desktop + mobile).
import Button from '../ui/Button.astro';
import { known } from '../../lib/dates';

type Entry = {
  from: string;
  to?: string;
  hash: string;
  company: string;
  ref?: 'head' | 'initial';
  role: string;
  summary: string;
  stack: string[];
};

// Start years come from the first commit on GitHub (Boko's rule); "20XX" is still unknown and stays hidden.
const entries: Entry[] = [
  {
    from: '2025',
    to: 'Now',
    hash: 'c618ff5',
    company: 'Quality Installs Co.',
    ref: 'head',
    role: 'Lead software engineer',
    summary: 'Leading QPIMS, QPAS and QP Invoicing: the platforms field crews and the office run on every day.',
    stack: ['Next.js', 'TypeScript', 'Supabase'],
  },
  {
    from: '2025',
    to: '2025',
    hash: '7e0230a',
    company: 'Elivate',
    role: 'Full-stack engineer',
    summary: 'Built the Elivate Wallet across web and mobile, from the API to the screens people tap.',
    stack: ['React', 'Node.js', 'PostgreSQL'],
  },
  {
    from: '2025',
    to: '20XX',
    hash: '0cec1ce',
    company: 'Freelance',
    role: 'Software developer',
    summary: 'Shipped products for clients in education and media, including the EduSkillUp LMS and Roudio.',
    stack: ['React', 'Python', 'Docker'],
  },
  {
    from: '2023',
    hash: '39a7e40',
    company: 'Startix Media',
    ref: 'initial',
    role: 'Junior web developer',
    summary: 'First job: websites and landing pages for agency clients. Learned to ship on a deadline.',
    stack: ['HTML', 'CSS', 'JavaScript'],
  },
];

const mono = 'font-mono font-medium text-[12.5px] leading-[150%] tracking-[0.01em] tabular-nums';
---

<section id="career" data-section="Timeline" aria-labelledby="timeline-title" class="bg-bg">
  <div class="page py-[68px] md:py-[151.2px]">
    <div class="grid items-start gap-[22px] lg:grid-cols-[minmax(0,1.25fr)_minmax(0,0.75fr)] lg:items-end lg:gap-14">
      <div class="grid max-w-[920px] min-w-0 justify-items-start gap-4 md:gap-[22px]">
        <p data-reveal="eyebrow" class="font-mono text-[12px] leading-[150%] font-medium tracking-[0.01em] md:text-[13px]">
          <span class="text-coral">//</span> git log --career
        </p>
        <h2 id="timeline-title" data-reveal="words" class="text-[38.4px] leading-none font-semibold tracking-[-0.045em] text-balance md:text-[64px]">
          Six years, every one <span class="text-coral">committed.</span>
        </h2>
      </div>
      <div data-reveal data-reveal-delay="200" class="grid min-w-0 justify-items-start gap-6">
        <p class="max-w-[527px] text-[15.5px] leading-[160%] text-pretty text-muted md:max-w-[578px] md:text-[17px]">
          Four teams, one direction: closer to the people who use the thing. The short version is below, the long one is a page away.
        </p>
        <div class="flex w-full min-w-0 flex-wrap items-center gap-x-7 gap-y-2.5">
          <Button href="/boko-isaac-cv.pdf" variant="secondary" icon="download" download="Boko-Isaac-CV.pdf" class="grow justify-between backdrop-blur-[8px] md:grow-0 md:justify-start">
            Download CV
          </Button>
          <a href="/resume" class="group flex min-h-11 items-center gap-[9px] rounded-sm font-mono text-[13px] leading-none font-medium tracking-[0.01em]">
            <span class="text-muted">01</span>
            <span class="py-1.5 underline-offset-4 group-hover:underline">Read the full resume</span>
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" class="shrink-0 text-coral transition-transform group-hover:translate-x-0.5">
              <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="relative mt-11 lg:mt-[72px]" data-branch>
      <div class="absolute inset-y-5 left-1.5 w-0.5 rounded-[2px] bg-rule lg:inset-y-[22px] lg:left-[195px]" aria-hidden="true"></div>
      <div data-branch-fill class="absolute inset-y-5 left-1.5 w-0.5 origin-top rounded-[2px] bg-coral lg:inset-y-[22px] lg:left-[195px]" aria-hidden="true"></div>
      <ol class="grid" data-reveal-stagger="70" data-reveal-delay="300" data-reveal-y="12">
        {
          entries.map((e, i) => {
            const last = i === entries.length - 1;
            return (
              <li
                class:list={[
                  'relative grid min-w-0 grid-cols-[30px_minmax(0,1fr)] items-start lg:grid-cols-[176px_40px_minmax(0,1fr)_minmax(0,auto)]',
                  last ? 'py-4 lg:py-[22px]' : 'pt-4 pb-[30px] lg:pt-[22px] lg:pb-[34px]',
                ]}
              >
                <p class="col-start-2 flex min-w-0 flex-wrap gap-x-3.5 gap-y-1 pb-2.5 lg:col-start-1 lg:row-start-1 lg:grid lg:gap-1 lg:pt-px lg:pb-0">
                  <span class:list={[mono]}>
                    {known(e.from) ? (
                      <>
                        {e.from}
                        {known(e.to) && e.to !== e.from && (
                          <>
                            <span class="text-muted italic lg:text-ink lg:not-italic"> to </span>
                            {e.to}
                          </>
                        )}
                      </>
                    ) : (
                      known(e.to) && <>Until {e.to}</>
                    )}
                  </span>
                  <span class:list={[mono, 'text-muted']}>{e.hash}</span>
                </p>
                <div class="relative col-start-1 row-span-3 row-start-1 h-full min-w-0 lg:col-start-2 lg:row-span-1" aria-hidden="true">
                  <span data-dot class="dot absolute top-0.5 left-0 size-3.5 rounded-full lg:top-px lg:left-[13px]" />
                </div>
                <div class="col-start-2 grid max-w-[760px] min-w-0 gap-2 lg:col-start-3 lg:row-start-1 lg:pr-10 lg:pl-4">
                  <p class="flex min-w-0 flex-wrap items-center gap-x-3.5 gap-y-1.5">
                    {e.ref === 'head' && (
                      <span class:list={[mono, 'flex items-center gap-2 text-coral']}>
                        <span class="size-2 shrink-0 rounded-full bg-coral" />
                        HEAD → main
                      </span>
                    )}
                    {e.ref === 'initial' && <span class:list={[mono, 'text-muted']}># initial commit</span>}
                    <span class:list={[mono]}>{e.company}</span>
                  </p>
                  <h3 class="text-[23px] leading-[108%] font-semibold tracking-[-0.045em] text-balance lg:text-[28px]">{e.role}</h3>
                  <p class="mt-0.5 max-w-[589px] text-[15.5px] leading-[160%] text-pretty text-muted lg:max-w-[608px] lg:text-[16px]">{e.summary}</p>
                </div>
                <ul class="col-start-2 flex min-w-0 flex-wrap gap-1.5 pt-3.5 lg:col-start-4 lg:row-start-1 lg:max-w-[300px] lg:justify-end lg:pt-0">
                  {e.stack.map((s) => (
                    <li class="inline-flex h-[26px] items-center rounded-[7px] px-[9px] font-mono text-[12px] leading-none font-medium tracking-[0.01em] shadow-[inset_0_0_0_1px_var(--color-rule-strong)]">
                      {s}
                    </li>
                  ))}
                </ul>
              </li>
            );
          })
        }
      </ol>
    </div>
  </div>
</section>

<style>
  /* Mobile: filled coral commits with a soft halo. Desktop: hollow muted rings on the coral line. */
  .dot {
    background: var(--color-coral);
    box-shadow:
      inset 0 0 0 2px var(--color-coral),
      0 0 0 5px rgb(255 127 80 / 16%);
  }
  @media (width >= 64rem) {
    .dot {
      background: var(--color-bg);
      box-shadow: inset 0 0 0 2px var(--color-muted);
    }
  }

  /* #25 while the branch draws (JS adds .is-drawing): unlit commits are hollow muted rings; a lit one
     goes back to its static style above with a small overshoot pop, so the end state is the design. */
  :global(.is-drawing) .dot {
    transition:
      background-color 0.35s,
      box-shadow 0.35s;
  }
  :global(.is-drawing) .dot:not(.is-lit) {
    background: var(--color-bg);
    box-shadow: inset 0 0 0 2px var(--color-muted);
  }
  :global(.is-drawing) .dot.is-lit {
    animation: dot-pop 0.45s cubic-bezier(0.2, 1.6, 0.4, 1);
  }
  @keyframes dot-pop {
    from {
      scale: 0.6;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reducedMotion } from '../../scripts/motion/core';
  import { onPage, readyCapped } from '../../scripts/motion/page';

  // #25 Career branch line draws on scroll: progress = (64% of the viewport − list top) / list height,
  // forced to 1 at the page bottom, monotonic (never un-draws), smoothed o += (s − o) × .14 per frame.
  // A commit lights when the fill reaches it. Once fully drawn, everything returns to the static markup.
  onPage(() => {
    const branch = document.querySelector<HTMLElement>('[data-branch]');
    const fill = branch?.querySelector<HTMLElement>('[data-branch-fill]');
    if (!branch || !fill || reducedMotion()) return;
    const dots = [...branch.querySelectorAll<HTMLElement>('[data-dot]')];
    let offsets: number[] = [];
    let s = 0;
    let o = 0;
    let ticking = false;
    let st: ScrollTrigger | null = null;
    let alive = true;

    const measure = () => {
      // Layout sizes, not the fill's rect: the fill is scaled, so its rect height is not its length.
      const top = branch.getBoundingClientRect().top + fill.offsetTop;
      const height = fill.offsetHeight || 1;
      offsets = dots.map((d) => {
        const r = d.getBoundingClientRect();
        return (r.top + r.height / 2 - top) / height;
      });
    };
    const render = () => {
      fill.style.transform = `scaleY(${o})`;
      dots.forEach((d, i) => d.classList.toggle('is-lit', o >= offsets[i] - 0.001));
    };
    const finish = () => {
      gsap.ticker.remove(tick);
      st?.kill();
      st = null;
      fill.style.transform = '';
      dots.forEach((d) => d.classList.add('is-lit'));
    };
    const tick = () => {
      o += (s - o) * 0.14;
      if (s - o < 0.0015) o = s;
      render();
      if (o >= 1) return finish();
      if (o === s) {
        gsap.ticker.remove(tick);
        ticking = false;
      }
    };
    const update = (p: number) => {
      if (ScrollTrigger.maxScroll(window) - window.scrollY < 2) p = 1;
      if (p <= s) return;
      s = Math.min(1, p);
      if (!ticking) {
        ticking = true;
        gsap.ticker.add(tick);
      }
    };

    branch.classList.add('is-drawing');
    fill.style.transform = 'scaleY(0)';
    readyCapped().then(() => {
      if (!alive) return;
      measure();
      render();
      st = ScrollTrigger.create({
        trigger: branch,
        start: 'top 64%',
        end: 'bottom 64%',
        onRefresh: (self) => {
          measure();
          update(self.progress);
        },
        onUpdate: (self) => update(self.progress),
      });
      update(st.progress);
    });

    return () => {
      alive = false;
      finish();
      branch.classList.remove('is-drawing');
      dots.forEach((d) => d.classList.remove('is-lit'));
    };
  });
</script>
