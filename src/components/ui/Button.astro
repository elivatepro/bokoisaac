---
// Buttons from Paper: label + 38px square icon tile. Primary = coral; secondary = outlined dark glass.
// Motion (#9, CSS in global.css): on hover/focus the arrow slides out right while a second one slides in from the
// left; the download icon drops out the bottom and falls back in from the top; the calendar icon stays put.
// Primary fills ink on hover.
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  icon?: 'arrow' | 'download' | 'calendar' | 'none';
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', icon = 'arrow', type = 'button', class: className = '', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const primary = variant === 'primary';
const arrow = 'M5 12h14M13 6l6 6-6 6';
---

<Tag
  href={href}
  type={href ? undefined : type}
  class:list={[
    'btn inline-flex h-[54px] shrink-0 items-center gap-3.5 rounded-[14px] pl-[22px] text-sm leading-none font-semibold tracking-[-0.005em]',
    icon === 'none' ? 'pr-[22px]' : 'pr-2',
    primary ? 'bg-coral text-coral-ink hover:bg-ink focus-visible:bg-ink' : 'border border-rule-strong bg-bg/55 text-ink backdrop-blur-[8px] hover:border-ink/40',
    className,
  ]}
  {...rest}
>
  <span class="whitespace-nowrap"><slot /></span>
  {
    icon !== 'none' && (
      <span
        class:list={[
          'grid size-[38px] shrink-0 place-items-center overflow-clip rounded-[9px]',
          primary ? 'bg-coral-ink text-coral' : 'bg-ink/9 text-ink',
        ]}
      >
        {icon === 'arrow' ? (
          <>
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" class="btn-ico-a col-start-1 row-start-1">
              <path d={arrow} fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" class="btn-ico-b col-start-1 row-start-1">
              <path d={arrow} fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </>
        ) : icon === 'calendar' ? (
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <rect x="4" y="5" width="16" height="15" rx="2.5" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M4 10h16M9 3v4M15 3v4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        ) : (
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" class="btn-drop">
            <path d="M12 4v13M6 12l6 6 6-6M5 21h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        )}
      </span>
    )
  }
</Tag>
