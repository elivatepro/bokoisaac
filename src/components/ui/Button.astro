---
// Buttons from Paper: label + 38px square icon tile. Primary = coral; secondary = outlined dark glass.
// The arrow tile holds two arrows (one parked off to the left, as in Paper); on hover they slide right together.
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  icon?: 'arrow' | 'download' | 'none';
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', icon = 'arrow', type = 'button', class: className = '', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const primary = variant === 'primary';
const arrow = 'M5 12h14M13 6l6 6-6 6';
---

<Tag
  href={href}
  type={href ? undefined : type}
  class:list={[
    'group inline-flex h-[54px] shrink-0 items-center gap-3.5 rounded-[14px] pl-[22px] text-sm leading-none font-semibold tracking-[-0.005em] transition-colors',
    icon === 'none' ? 'pr-[22px]' : 'pr-2',
    primary ? 'bg-coral text-coral-ink hover:bg-[#ff8f66]' : 'border border-rule-strong bg-bg/55 text-ink backdrop-blur-[8px] hover:border-ink/40',
    className,
  ]}
  {...rest}
>
  <span class="whitespace-nowrap"><slot /></span>
  {
    icon !== 'none' && (
      <span
        class:list={[
          'grid size-[38px] shrink-0 place-items-center overflow-clip rounded-[9px]',
          primary ? 'bg-coral-ink text-coral' : 'bg-ink/9 text-ink',
        ]}
      >
        {icon === 'arrow' ? (
          <>
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" class="col-start-1 row-start-1 transition-transform duration-300 ease-out group-hover:translate-x-[34px] motion-reduce:transition-none">
              <path d={arrow} fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" class="col-start-1 row-start-1 -translate-x-[34px] transition-transform duration-300 ease-out group-hover:translate-x-0 motion-reduce:transition-none">
              <path d={arrow} fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </>
        ) : (
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <path d="M12 4v13M6 12l6 6 6-6M5 21h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        )}
      </span>
    )
  }
</Tag>
