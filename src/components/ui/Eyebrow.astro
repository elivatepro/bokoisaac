---
// The "// Label" line above section headings (JetBrains Mono 13px, coral slashes).
// Extra attributes (e.g. data-reveal="eyebrow") pass through to the <p>.
interface Props {
  class?: string;
  [key: string]: unknown;
}
const { class: className = '', ...rest } = Astro.props;
---

<p class:list={['eyebrow text-ink', className]} {...rest}><span class="text-coral">//</span> <slot /></p>
