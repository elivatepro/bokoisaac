---
// Top of an index page (Work, Writing, Services…), from Paper: "// Label", big title, lead, optional stat row.
// The template's faint grid sits behind it, fading from the top right (84% / 8%).
// Title: pass `title` and `accent` (the coral tail), e.g. title="Eight products, each one" accent="shipped.".
// Buttons under the lead: the `actions` slot or the default slot (About, Process, Reviews, FAQ). `aside` is a
// card on the right (the commit card on Stack / Now; it drops below the copy on mobile). `wrapStats` lets stats
// wrap two to a row on mobile (About). `pad` / `gapClass` / `wideGap` / `maxWidth` follow per-page Paper spacing.
import Eyebrow from '../ui/Eyebrow.astro';
import GridBg from '../ui/GridBg.astro';

interface Props {
  eyebrow: string;
  title: string;
  accent: string;
  lead: string;
  stats?: { label: string; value: string | number }[];
  id?: string;
  /** Lead paragraph max width in px (Paper: 684 on most pages, 760 on Writing). */
  leadMax?: number;
  /** Text block max width in px (Paper: 940; 1120 on FAQ, where the title fits one line). */
  maxWidth?: number;
  wrapStats?: boolean;
  /** Padding of the inner page container (Paper varies it per page). `padClass` is the same thing. */
  pad?: string;
  padClass?: string;
  /** Gap between the blocks; `wideGap` = 22px on mobile too (Process, Reviews, FAQ). */
  gapClass?: string;
  wideGap?: boolean;
}
const {
  eyebrow,
  title,
  accent,
  lead,
  stats = [],
  id = 'page-title',
  leadMax = 684,
  maxWidth = 940,
  wrapStats = false,
  pad,
  padClass,
  gapClass,
  wideGap = false,
} = Astro.props;
const padding = pad ?? padClass ?? 'pt-[112px] pb-7 md:pt-[208px] md:pb-[60px]';
const gap = gapClass ?? (wideGap ? 'gap-[22px]' : 'gap-4 md:gap-[22px]');
const mono = 'font-mono font-medium tracking-[0.01em] tabular-nums';
const hasActions = Astro.slots.has('actions') || Astro.slots.has('default');
const hasAside = Astro.slots.has('aside');
---

<section aria-labelledby={id} class="relative isolate">
  <GridBg x="84%" y="8%" />
  <div class:list={['page relative', padding]}>
    <div class:list={['grid grid-cols-[minmax(0,1fr)]', hasAside && 'gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,420px)] md:items-end md:gap-24']}>
      <div style={`max-width:${maxWidth}px`} class:list={['grid min-w-0 grid-cols-[minmax(0,1fr)] justify-items-start', gap]}>
        <Eyebrow data-reveal="eyebrow">{eyebrow}</Eyebrow>
        <h1 {id} data-reveal="words" class="text-[38.4px] leading-[98%] font-semibold tracking-[-0.045em] text-balance md:text-[84px]">
          {title} <span class="text-coral">{accent}</span>
        </h1>
        <p data-reveal data-reveal-delay="200" style={`max-width:${leadMax}px`} class="text-[15.5px] leading-[160%] text-pretty text-muted md:text-[19px]">{lead}</p>
        {
          hasActions && (
            <div data-reveal data-reveal-delay="240" class="mt-2 flex w-full min-w-0 flex-wrap gap-3 md:w-auto">
              <slot name="actions" />
              <slot />
            </div>
          )
        }
        {
          stats.length > 0 && (
            <dl data-reveal data-reveal-delay="260" class="mt-[18px] flex w-full max-w-[780px] flex-wrap border-t border-rule pt-5">
              {stats.map((s) => (
                <div class:list={['min-w-0 flex-1 pr-3 md:min-w-[120px] md:basis-0 md:pr-5', wrapStats ? 'basis-[40%] pb-4 md:pb-0' : 'basis-0']}>
                  <dt class:list={[mono, 'text-[12px] leading-[140%] text-muted']}>{s.label}</dt>
                  <dd class:list={['mt-2 leading-none font-semibold tracking-[-0.045em] tabular-nums md:text-[36px]', wrapStats ? 'text-[26px]' : 'text-[28px]']}>{s.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
      {
        hasAside && (
          <div data-reveal data-reveal-delay="300" class="grid min-w-0 justify-items-start md:justify-items-end">
            <slot name="aside" />
          </div>
        )
      }
    </div>
  </div>
</section>
