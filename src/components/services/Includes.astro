---
// The "Includes" checklist: a coral-ringed check tile and the item. Cards use two columns from md up;
// the detail page's side card is one column at 15.5px.
interface Props {
  items: string[];
  columns?: boolean;
}
const { items, columns = false } = Astro.props;
---

<ul class:list={['grid min-w-0', columns ? 'gap-x-6 gap-y-[11px] md:grid-cols-2' : 'gap-3']}>
  {
    items.map((item) => (
      <li class="grid min-w-0 grid-cols-[20px_minmax(0,1fr)] items-start gap-[10px]">
        <span class="mt-px grid size-5 place-items-center rounded-[5px] shadow-[inset_0_0_0_1px_#ff7f5073]" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="11" height="11">
            <path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="var(--color-coral)" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <span class:list={['min-w-0 leading-[145%]', columns ? 'text-[15px]' : 'text-[15.5px]']}>{item}</span>
      </li>
    ))
  }
</ul>
